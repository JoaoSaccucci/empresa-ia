# Arquivos que o Git deve ignorar (não vão para o GitHub)

# Lixo do sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Configurações pessoais de editor e do Claude Code
.vscode/
.claude/settings.local.json

# Dependências e registros (caso algum projeto futuro use)
node_modules/
*.log

# Projetos independentes (Etapa 6): cada projeto novo em trabalhos/<projeto>/
# tem o próprio repositório Git e não entra neste. Só a Labs fica aqui.
trabalhos/*
!trabalhos/joao-saccucci-labs/
